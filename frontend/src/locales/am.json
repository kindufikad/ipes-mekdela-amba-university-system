  "about": {
    "title": "ስለ መምህራን የአፈጻጸም ግምገማ ስርዓት (IPES)",
    "system_name": "የመቅደላ አምባ ዩኒቨርሲቲ የዲጂታል መምህራን አፈጻጸም ግምገማ ፕላትፎርም",
    "who_we_are_title": "ማን ነን",
    "description": "የመምህራን የአፈጻጸም ግምገማ ስርዓት (IPES) ለመቅደላ አምባ ዩኒቨርሲቲ ግልጽ የአስተማሪ አፈጻጸም ግምገማ የሚያቀርብ ዋና ዲጂታል መድረክ ነው። የተማሪዎችን እና የመምህራንን ግብረመልስ በማቀናጀት የግምገማ ሂደትን ያቀላጥፋል፣ የማስተማር ጥራትን ለማሻሻልም ለዩኒቨርሲቲው ግልጽ መረጃ ይሰጣል።",
    "mission_title": "ተልዕኳችን",
    "mission_description": "ግልጽ፣ ቀልጣፋ እና ተደራሽ የግምገማ መድረክ በማቅረብ በማስተማር ላይ ቀጣይ የማሻሻያ ባህልን ማበረታታት።",
    "vision_title": "ራዕያችን",
    "vision_description": "በመረጃ ላይ በተመሠረቱ ውሳኔዎች እና ግልጽ የግብረመልስ ዘዴዎች የአካዳሚክ የላቀነትን ማበረታታት።",
    "objectives_title": "ዋና ዓላማዎች",
    "objectives": [
